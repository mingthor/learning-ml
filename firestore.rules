rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: stats
    // Document ID: {questionId}_{userId}
    // Fields:
    //   - viewCount: number (required, >= 0)
    //   - skipCount: number (required, >= 0)
    //   - mastery: number (required, 0-10)
    //   - updatedAt: timestamp (required)
    //   - userId: string (required, must match auth.uid)
    //
    // ===============================================================

    // Collection: backgrounds
    // Document ID: {questionId}
    // Fields:
    //   - content: string (required)
    //   - updatedAt: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isValidStats(data) {
      return data.keys().hasAll(['viewCount', 'skipCount', 'mastery', 'updatedAt', 'userId']) &&
             data.keys().hasOnly(['viewCount', 'skipCount', 'mastery', 'updatedAt', 'userId']) &&
             data.viewCount is number && data.viewCount >= 0 &&
             data.skipCount is number && data.skipCount >= 0 &&
             data.mastery is number && data.mastery >= 0 && data.mastery <= 10 &&
             data.updatedAt is timestamp &&
             data.userId is string && data.userId == request.auth.uid;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /stats/{statsId} {
      // Users can only read their own stats
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      
      // Users can only create/update their own stats with valid data
      allow create: if isAuthenticated() && isValidStats(request.resource.data);
      allow update: if isAuthenticated() && isDocOwner() && isValidStats(request.resource.data);
      
      // Users can delete their own stats
      allow delete: if isAuthenticated() && isDocOwner();
    }

    match /backgrounds/{questionId} {
      // Anyone authenticated can read backgrounds
      allow read: if isAuthenticated();
      
      // Anyone authenticated can create/update backgrounds (shared across users)
      allow create, update: if isAuthenticated() && 
                             request.resource.data.content is string && 
                             request.resource.data.content.size() > 0 &&
                             request.resource.data.updatedAt is timestamp;
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
